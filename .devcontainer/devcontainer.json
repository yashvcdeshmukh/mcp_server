{
  "name": "equipment-mcp",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "uv sync --frozen --all-groups",
  "remoteEnv": {
    "OLLAMA_HOST": "http://host.docker.internal:11434"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
